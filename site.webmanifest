{
  "id": "/",
  "name": "إحصائيات دوري زين الممتاز",
  "short_name": "mfsoccer",
  "description": "أرقام المباريات والأهداف واللاعبين وجدول الترتيب لدوري زين الممتاز.",
  "lang": "ar",
  "dir": "rtl",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#061529",
  "theme_color": "#061529",
  "categories": ["sports", "news"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": "navigate-existing" },
  "icons": [
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/apple-touch-icon.png", "sizes": "180x180", "type": "image/png" },
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "المباريات",
      "short_name": "المباريات",
      "description": "نتائج الجولة والمباريات القادمة",
      "url": "/?v=matches",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "جدول الترتيب",
      "short_name": "الترتيب",
      "description": "ترتيب الأندية ونقاطها",
      "url": "/?v=clubs",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "التوقعات",
      "short_name": "التوقعات",
      "description": "توقّع نتائج الجولة ونافس الجمهور",
      "url": "/?v=predict",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "فانتسي",
      "short_name": "فانتسي",
      "description": "كوّن فريقك ونافس على النقاط",
      "url": "/fantasy/",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
