rules_version = '2';

// mfsoccer security rules
// Owner   : full access.
// Editor  : season data only (matches, goals, cards, penalties, squads).
// Fan     : own profile + own predictions, until the round locks.
// Manager : own fantasy profile + squad. Points are written by staff only.
// Public  : read season data, assets, the leaderboard and the fantasy game.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
          && request.auth.uid == "iiTgVfDryXNLb9IrOyLkkNMHDxq2";
    }

    // Mansour may score predictions too (read all preds, write boards) - 2026-10-11
    function isPredAdmin() {
      return isOwner() || (request.auth != null && request.auth.uid == "8wlEYODqGPTqZKSQEtevcz0MGEl2");
    }

    function staffMembers() {
      return get(/databases/$(database)/documents/seasons/staff).data.members;
    }

    function isEditor() {
      return request.auth != null
          && exists(/databases/$(database)/documents/seasons/staff)
          && request.auth.uid in staffMembers()
          && staffMembers()[request.auth.uid].role == "editor"
          && staffMembers()[request.auth.uid].active == true;
    }

    // Staff document: signed-in read, owner-only write.
    match /seasons/staff {
      allow read:  if request.auth != null;
      allow write: if isOwner() || (request.auth != null && request.auth.uid == "8wlEYODqGPTqZKSQEtevcz0MGEl2");
    }

    // Staff presence (2026-11-10): a heartbeat each member writes for
    // themselves; the control-room page reads it. Nothing else touches this
    // collection, so it cannot affect any existing document.
    match /presence/{uid} {
      allow read:  if isOwner() || isEditor();
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && (isOwner() || isEditor());
    }

    // Logos and branding: public read, owner-only write.
    match /seasons/assets {
      allow read:  if true;
      allow write: if isOwner();
    }

    // Season data: public read, owner or active editor writes.
    match /seasons/{doc} {
      allow read:  if doc != "staff";
      allow write: if doc != "staff" && doc != "assets" && (isOwner() || isEditor());
    }

    // Round metadata, including the prediction lock time. Owner-only write.
    match /rounds/{rk} {
      allow read:  if true;
      allow write: if isOwner();
    }

    // Fan profile: each fan reads and writes only their own.
    match /fans/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Predictions: a fan writes only their own, only before the round locks,
    // and only to the document id "<roundKey>_<uid>". No deletes, ever.
    match /preds/{pid} {
      allow read: if isPredAdmin()
                  || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && pid == request.resource.data.rk + "_" + request.auth.uid
        && exists(/databases/$(database)/documents/rounds/$(request.resource.data.rk))
        && get(/databases/$(database)/documents/rounds/$(request.resource.data.rk)).data.open == true
        && request.time < get(/databases/$(database)/documents/rounds/$(request.resource.data.rk)).data.lockAt;
      // A fan may erase their own predictions ‚Äî needed for in-app account
      // deletion. Re-creating one after the lock stays impossible, so this
      // can only ever forfeit points, never gain them.
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    // Team of the round: one ballot per fan per round, at
    // "<round>|<competition>_<uid>". Public read so the tally and the
    // voter list can be shown. A fan writes only their own ballot, and
    // only while staff have opened voting for that round. The approved
    // result lives inside the season document, written by staff ‚Äî a fan
    // can never touch it. No deletes.
    // Voting window, mirrored out of the season document into one doc per
    // round so the rules can read it directly. Written by staff alongside
    // the toggle in the admin panel.
    function totOpen(rk) {
      return exists(/databases/$(database)/documents/totlock/$(rk))
          && get(/databases/$(database)/documents/totlock/$(rk)).data.open == true;
    }
    match /totlock/{rk} {
      allow read:  if true;
      allow write: if isOwner() || isEditor();
    }
    /* تصويت أفضل لاعب لكل مباراة (2026-10-11): صوت واحد لكل مشجع في كل مباراة */
    match /motm/{vid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && vid == request.resource.data.mid + "_" + request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','mid','name','n','c','ts'])
        && request.resource.data.n is string && request.resource.data.n.size() < 80
        && request.resource.data.c is string && request.resource.data.c.size() < 40;
      allow delete: if isOwner() || isEditor();
    }
    match /tots/{vid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && vid == request.resource.data.rk + "_" + request.auth.uid
        && request.resource.data.xi.size() == 11
        && totOpen(request.resource.data.rk);
      allow delete: if isOwner() || isEditor()
                    || ( request.auth != null
                         && resource.data.uid == request.auth.uid );
    }

    // Leaderboard: public read, owner-only write.
    match /boards/{sid} {
      allow read:  if true;
      allow write: if isPredAdmin();
    }

    // Visit counter: public read, and any client may add exactly one
    // visit to today's document. No arbitrary values, no other fields.
    match /stats/{day} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['v', 'd'])
                    && request.resource.data.v == 1
                    && request.resource.data.d == day;
      allow update: if request.resource.data.keys().hasOnly(['v', 'd'])
                    && request.resource.data.v == resource.data.v + 1
                    && request.resource.data.d == resource.data.d;
      allow delete: if isOwner();
    }

    // Season backups: a full snapshot written after every successful save,
    // so a wipe can be rolled back. Staff only ‚Äî these are working copies,
    // not public data. Never editable once written; pruning deletes old ones.
    match /backups/{bid} {
      allow read:   if isOwner() || isEditor();
      allow create: if (isOwner() || isEditor())
                    && request.resource.data.data.matches.size() > 0;
      allow update: if false;
      allow delete: if isOwner() || isEditor();
    }

    // ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ Fantasy ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ
    // Same staff model as the rest of the site: owner or active editor
    // publishes the game and writes the points. Managers own their squad
    // and nothing else ‚Äî a manager can never write their own score.

    function isFanAdmin() {
      return isOwner() || isEditor();
    }

    // Squad deadline, mirrored from the gameweek into a document the rules
    // can read. Written by staff whenever the game is published.
    function fanLock(season) {
      return get(/databases/$(database)/documents/fantasy/$(season)/meta/lock).data;
    }
    function fanWindowOpen(season) {
      return exists(/databases/$(database)/documents/fantasy/$(season)/meta/lock)
          && fanLock(season).open == true
          && request.time < fanLock(season).deadline;
    }

    match /fantasy/{season} {

      // Game state: rules, scoring table, gameweeks. Public read.
      allow read:  if true;
      allow write: if isFanAdmin();

      // Player list and prices.
      match /meta/{doc} {
        allow read:  if true;
        allow write: if isFanAdmin();
      }

      // Fixtures and per-player match stats, one document per gameweek.
      match /rounds/{gw} {
        allow read:  if true;
        allow write: if isFanAdmin();
      }

      // Managers. Public read so the leaderboard can be built.
      // Audit 2026-11-09: a manager's own team save must be a sane squad, must not change
      // used chips or the rollover marker, and must raise the team revision by exactly one
      // (a device holding an older copy cannot overwrite a newer save).
      function teamOk(n, d) {
        return n == null
          || ( ( n.get('squad', []).size() == 0
                 || ( n.squad.size() == 15 && n.squad.toSet().size() == 15
                      && n.get('xi', []).size() == 11 && n.get('bench', []).size() == 4 ) )
               && ( d.get('team', null) == null
                    || ( n.get('usedChips', {}) == d.team.get('usedChips', {})
                         && n.get('rolledGW', 0) == d.team.get('rolledGW', 0)
                         && ( !('rev' in d.team) || n.get('rev', 0) == d.team.rev + 1 ) ) ) );
      }

      match /managers/{uid} {

        allow read: if true;

        // Sign-up: only for yourself, you start on zero, and only the
        // expected fields may be present ‚Äî nothing smuggled in at creation.
        allow create: if request.auth != null
                      && request.auth.uid == uid
                      && request.resource.data.keys().hasOnly(
                           ['username','teamName','avatar','joinedGW',
                            'created','updated','team','history','total','lastGW'])
                      && request.resource.data.total == 0
                      && request.resource.data.history.size() == 0
                      // Late joiner at sign-up (2026-10-09): a squad created after the
                      // deadline must start from the next gameweek.
                      && ( fanWindowOpen(season)
                           || request.resource.data.get('team', null) == null
                           || request.resource.data.team.get('squad', []).size() == 0
                           || ( exists(/databases/$(database)/documents/fantasy/$(season)/meta/lock)
                                && request.resource.data.get('joinedGW', 0) == fanLock(season).gw + 1 ) );

        // Updates. A manager may change only their profile and squad ‚Äî
        // never their own points, standings, joined week or last-scored
        // week ‚Äî and may change the squad only while the window is open.
        // Once the deadline passes the squad is frozen on the server, not
        // just in the interface; the profile stays editable.
        allow update: if isFanAdmin()
                      || ( request.auth != null
                           && request.auth.uid == uid
                           && request.resource.data.diff(resource.data)
                                .affectedKeys().hasOnly(
                                  ['username','teamName','avatar','updated','team'])
                           && ( !request.resource.data.diff(resource.data)
                                  .affectedKeys().hasAny(['team'])
                                || ( fanWindowOpen(season)
                                     && teamOk(request.resource.data.get('team', null), resource.data) ) ) )

                      // Late joiner (2026-10-09): someone with no squad on the server who
                      // builds a team after the deadline is saved as joining NEXT gameweek
                      // (joinedGW = locked gameweek + 1), so the locked week never counts it.
                      || ( request.auth != null
                           && request.auth.uid == uid
                           && request.resource.data.diff(resource.data)
                                .affectedKeys().hasOnly(
                                  ['username','teamName','avatar','updated','team','joinedGW'])
                           && exists(/databases/$(database)/documents/fantasy/$(season)/meta/lock)
                           && request.resource.data.joinedGW == fanLock(season).gw + 1
                           && ( resource.data.get('joinedGW', 0) == fanLock(season).gw + 1
                                || resource.data.get('team', null) == null
                                || resource.data.team.get('squad', []).size() == 0 ) );

        // Deleting: staff, or the manager erasing their own account from
        // inside the app (App Store guideline 5.1.1(v)).
        allow delete: if isFanAdmin()
                      || ( request.auth != null && request.auth.uid == uid );
      }

      // Private leagues.
      match /leagues/{lg} {

        allow read: if true;

        // Creating: you are the owner and the only member.
        allow create: if request.auth != null
                      && request.resource.data.owner == request.auth.uid
                      && request.resource.data.members.hasOnly([request.auth.uid]);

        // Joining by code adds yourself and nothing else. The league owner
        // may edit their own league. Nobody can remove another member.
        allow update: if ( request.auth != null
                           && resource.data.owner == request.auth.uid )
                      || ( request.auth != null
                           && request.resource.data.diff(resource.data)
                                .affectedKeys().hasOnly(['members'])
                           && request.resource.data.members.hasAll(resource.data.members)
                           && request.resource.data.members.hasOnly(
                                resource.data.members.concat([request.auth.uid])) )
                      // Leaving: you may remove yourself and nobody else.
                      // Needed so deleting an account clears its memberships.
                      || ( request.auth != null
                           && request.resource.data.diff(resource.data)
                                .affectedKeys().hasOnly(['members'])
                           && resource.data.members.hasAll(request.resource.data.members)
                           && !(request.auth.uid in request.resource.data.members)
                           && resource.data.members
                                .removeAll(request.resource.data.members)
                                .hasOnly([request.auth.uid]) )
                      || isFanAdmin();

        allow delete: if ( request.auth != null
                           && resource.data.owner == request.auth.uid )
                      || isFanAdmin();
      }

      // Abuse reports (App Store guideline 1.2). Any signed-in player may
      // file one against another player; only staff ever read them.
      match /reports/{id} {
        allow create: if request.auth != null
                      && request.resource.data.by == request.auth.uid
                      && request.resource.data.keys().hasOnly(
                           ['target','targetName','reason','note','by','at'])
                      && request.resource.data.note.size() <= 400
                      && request.resource.data.targetName.size() <= 60
                      && request.resource.data.reason.size() <= 80;
        allow read, update, delete: if isFanAdmin();
      }

      // In-game suggestions and support chat. Anyone may send one ‚Äî only
      // the allowed fields, and the text capped so it can't be abused as
      // storage. Staff read, reply and triage. A signed-in sender reads
      // their own threads, may append exactly one reply of their own at a
      // time (which reopens the thread as "new"), and may clear their own
      // unread counter. Nobody else can read another player's note.
      function fbOwner() {
        return request.auth != null && resource.data.uid == request.auth.uid;
      }
      function fbOldReplies() {
        return ('replies' in resource.data) ? resource.data.replies : [];
      }
      match /feedback/{id} {
        allow create: if request.resource.data.keys().hasOnly(
                           ['type','text','username','teamName','uid','gw','ver','ua','created','status',
                            'replies','updated','userUnread'])
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 1500
                      && (request.resource.data.uid == ''
                          || (request.auth != null && request.resource.data.uid == request.auth.uid));
        allow read: if isFanAdmin() || fbOwner();
        allow update: if isFanAdmin()
                      || ( fbOwner()
                           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userUnread'])
                           && request.resource.data.userUnread == 0 )
                      || ( fbOwner()
                           && request.resource.data.diff(resource.data).affectedKeys()
                                .hasOnly(['replies','updated','status'])
                           && request.resource.data.status == 'new'
                           && request.resource.data.replies.size() == fbOldReplies().size() + 1
                           && request.resource.data.replies[fbOldReplies().size()].by == 'user'
                           && request.resource.data.replies[fbOldReplies().size()].text is string
                           && request.resource.data.replies[fbOldReplies().size()].text.size() <= 1500 );
        allow delete: if isFanAdmin() || fbOwner();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }

    // ───────────────────────── الأخبار (2026-10-22) ─────────────────────────
    // المالك أو «مدير» فعّال. المحرر بصلاحية المباريات فقط (perm "matches")
    // لا يكتب الأخبار. الزائر يقرأ المقال المنشور فقط؛ المسودات وغير المنشور
    // للطاقم وحده. فهرس المنشور في seasons/news (قاعدة seasons).
    function isNewsStaff() {
      return isOwner()
          || (isEditor() && staffMembers()[request.auth.uid].get('perm', 'full') != 'matches');
    }
    match /news/{id} {
      allow read:  if isNewsStaff() || resource.data.status == 'published';
      allow create, update: if isNewsStaff()
                    && request.resource.data.status in ['draft', 'published', 'unpublished']
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 200;
      allow delete: if isNewsStaff();
    }
    // صور الأخبار: dataURL مضغوطة، عامة القراءة (تُخدم عبر /api/newsimg)
    match /newsimg/{id} {
      allow read:  if true;
      allow create, update: if isNewsStaff()
                    && request.resource.data.d is string
                    && request.resource.data.d.matches('^data:image/(webp|jpeg|png);base64,.*')
                    && request.resource.data.d.size() < 1040000;
      allow delete: if isNewsStaff();
    }
  }
}
